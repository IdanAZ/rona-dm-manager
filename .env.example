# === מצב הרצה ===
# true = בלי חיבור אמיתי לאינסטגרם (ברירת מחדל לפיתוח)
# false = חיבור אמיתי ל-Graph API (דורש את הפרטים למטה)
MOCK_MODE=true
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# נתיב ההתחברות החי:
# facebook  = Facebook Login for Business / Unified Login (ברירת מחדל, graph.facebook.com)
# instagram = Instagram Login הישן (graph.instagram.com) — אופציונלי, אם זמין באפליקציית Meta
AUTH_MODE=facebook

# כתובת ציבורית של האפליקציה (בלי סלאש בסוף).
# בפיתוח מקומי: http://localhost:3000
# במנהרת בדיקה: https://xxxx.trycloudflare.com  (משתנה אחרי הפעלה מחדש)
# בפרודקשן: https://your-app.onrender.com
# אם APP_URL לא מוגדר, נעשה שימוש ב-RENDER_EXTERNAL_URL (Render ממלא אותו אוטומטית).
APP_URL=http://localhost:3000

# סוד לחתימת עוגיות התחברות. חובה להחליף בפרודקשן.
SESSION_SECRET=change-me-to-a-long-random-string

# בסיס נתונים:
# אם DATABASE_URL מוגדר (postgres:// או postgresql://) — האפליקציה משתמשת ב-Postgres (חובה ב-Render,
# כי מערכת הקבצים של שירות Web חינמי נמחקת אחרי spin-down / redeploy).
# אחרת נשמר SQLite בנתיב DB_PATH.
# DATABASE_URL=postgres://user:pass@localhost:5432/rona
DB_PATH=./data/rona-insta.db

# === פרטי אפליקציית Meta (נדרשים כש-MOCK_MODE=false) ===
# מתוך Meta for Developers → האפליקציה (App ID / App Secret)
META_APP_ID=
META_APP_SECRET=

# מזהה תצורת Facebook Login for Business (config_id)
# נוצר ב: Use cases → Manage messaging & content on Instagram → Customize
#         → API setup with Unified login → Configure your app
META_CONFIG_ID=

# אסימון לאימות Webhook (אותו ערך גם בלוח ה-Meta).
# ב-Render עם render.yaml הערך נוצר אוטומטית (generateValue) — מעתיקים אותו מ:
# Render Dashboard → השירות → Environment → WEBHOOK_VERIFY_TOKEN
# ומדביקים ב-Meta → Webhooks → Verify token. הוא לא מתחדש בסנכרון Blueprint חוזר.
WEBHOOK_VERIFY_TOKEN=rona-insta-verify

# גרסת Graph API
GRAPH_API_VERSION=v23.0

# הרשאות — ב-AUTH_MODE=facebook ההרשאות האמיתיות מגיעות מהתצורה (config_id).
# הרשימה הזו משמשת רק אם אין META_CONFIG_ID, או לתיעוד.
FACEBOOK_SCOPES=instagram_basic,instagram_manage_comments,instagram_manage_messages,pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging,business_management

# הרשאות ל-AUTH_MODE=instagram בלבד
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages

# בדיקת "חייבת לעקוב קודם":
# stub = לא קוראים ל-API (ברירת מחדל)
# api  = GET /{IGSID}?fields=is_user_follow_business (User Profile API, עם Page token).
#        דורש הסכמת המשתמשת (בדרך כלל אחרי שהיא כבר שלחה הודעה). אם אין הסכמה או שהשדה חסר — לא חוסמים.
FOLLOW_CHECK_MODE=stub

# מרווחי סריקה (מילישניות)
MEDIA_POLL_INTERVAL_MS=120000
FOLLOWUP_INTERVAL_MS=60000
# סריקת תגובות בשרת לאוטומציות פעילות על פוסט מסוים (ברירת מחדל: כל דקה).
# משלים תגובה בפוסט + DM אם הוובהוק פספס (למשל כשהשירות ב-Render Free ישן).
POLL_INTERVAL_MS=60000
